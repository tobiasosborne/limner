{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.11.1"}
        org.clojure/core.async {:mvn/version "1.6.681"}}
 :aliases
 {;; clojure -M:test                      (all tests)
  ;; clojure -M:test -n limner.core-test  (one namespace)
  :test {:extra-paths ["test" "scripts"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}}
         :main-opts ["-m" "limner.test-runner"]}
  :benchmark {:extra-paths ["scripts"]}
  :text-bench {:extra-paths ["bench"]
               :main-opts ["-m" "limner.text-bench"]}
  :icu {:extra-deps {com.ibm.icu/icu4j {:mvn/version "78.1"}}}}}
