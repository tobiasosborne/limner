{:paths ["src" "test" "scripts" "bench"]
 :deps {org.clojure/core.async {:mvn/version "1.6.681"}}
 :tasks
 {:requires ([limner.benchmarks :as bench]
             [limner.check :as check]
             [limner.test-runner :as test-runner]
             [babashka.process :refer [shell]])

  fetch-ucd {:doc "Fetch and verify a pinned Unicode version"
             :task (apply shell "bb" "scripts/fetch-ucd.clj"
                          *command-line-args*)}

  gen-unicode {:doc "Regenerate Unicode lookup tables from vendored data"
               :task (do
                       (load-file "scripts/gen-unicode-tables.clj")
                       (apply (ns-resolve 'gen-unicode-tables '-main)
                              *command-line-args*))}

  test {:doc "Run every test namespace (optionally: bb test -n namespace)"
        :task (apply test-runner/-main *command-line-args*)}

  check {:doc "Run JVM tests, babashka tests, then available lint"
         :task (check/-main)}

  ;; Call -main directly: babashka's `exec` passes -main a parsed-args map
  ;; (and merges any extra argument into it as if it were a map).

  benchmark {:doc "Run performance benchmarks (optionally: bb benchmark <suite>)"
             :task (apply bench/-main *command-line-args*)}

  benchmark:color {:doc "Run color system benchmarks only"
                   :task (bench/-main "color")}

  benchmark:unicode {:doc "Run Unicode width benchmarks only"
                     :task (bench/-main "unicode")}

  benchmark:grapheme {:doc "Compare portable and legacy grapheme segmentation"
                      :task (do
                              (require 'grapheme-benchmark)
                              ((resolve 'grapheme-benchmark/-main)))}

  benchmark:ansi {:doc "Measure ECMA-48 tokenization and stripping"
                  :task (do
                          (require 'ansi-benchmark)
                          ((resolve 'ansi-benchmark/-main)))}

  benchmark:text {:doc "Measure styled-text operations and width baselines"
                  :task (do
                          (require 'limner.text-bench)
                          ((resolve 'limner.text-bench/-main)))}

  bench-check {:doc "Check text performance budgets on JVM and babashka"
               :task (do
                       (shell "timeout" "180s" "clojure" "-M:text-bench" "--check")
                       (require 'limner.text-bench)
                       ((resolve 'limner.text-bench/-main) "--check"))}

  width-oracles {:doc "Generate the external width-oracle report"
                 :task (shell "timeout" "600s" "clojure" "-M:benchmark:icu"
                              "-e" "(load-file \"scripts/width-oracles.clj\") (width-oracles/-main)")}

  benchmark:layout {:doc "Run layout calculation benchmarks only"
                    :task (bench/-main "layout")}

  benchmark:borders {:doc "Run border rendering benchmarks only"
                     :task (bench/-main "borders")}

  benchmark:render {:doc "Run render & diff algorithm benchmarks only"
                    :task (bench/-main "render")}

  benchmark:events {:doc "Run event processing benchmarks only"
                    :task (bench/-main "events")}

  benchmark:state {:doc "Run state management benchmarks only"
                   :task (bench/-main "state")}}}
